<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Vehicle States for Rental Fleet -->
        <record id="vehicle_state_available" model="fleet.vehicle.state">
            <field name="name">Disponível</field>
            <field name="code">avaliable</field>
            <field name="sequence">10</field>
        </record>

        <record id="vehicle_state_inspection" model="fleet.vehicle.state">
            <field name="name">Em Inspeção / Vistoria</field>
            <field name="code">inspection</field>
            <field name="sequence">20</field>
        </record>

        <record id="vehicle_state_contract" model="fleet.vehicle.state">
            <field name="name">Em Contrato</field>
            <field name="code">contract</field>
            <field name="sequence">30</field>
        </record>

        <record id="vehicle_state_rent" model="fleet.vehicle.state">
            <field name="name">Em Locação</field>
            <field name="code">rent</field>
            <field name="sequence">40</field>
        </record>

        <record id="vehicle_state_in_progress" model="fleet.vehicle.state">
            <field name="name">Em Manutenção / Serviço</field>
            <field name="code">in_progress</field>
            <field name="sequence">50</field>
        </record>

        <record id="vehicle_state_complete" model="fleet.vehicle.state">
            <field name="name">Concluído</field>
            <field name="code">complete</field>
            <field name="sequence">60</field>
        </record>

        <record id="vehicle_state_released" model="fleet.vehicle.state">
            <field name="name">Liberado</field>
            <field name="code">released</field>
            <field name="sequence">70</field>
        </record>

        <record id="vehicle_state_write_off" model="fleet.vehicle.state">
            <field name="name">Baixado (Write-Off)</field>
            <field name="code">write-off</field>
            <field name="sequence">80</field>
        </record>
    </data>
</odoo>
