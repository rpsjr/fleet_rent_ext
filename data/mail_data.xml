<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="email_rent_invoice_template" model="mail.template">
        <field name="name">Fatura de Locação Recorrente: Enviar por Email</field>
        <field
            name="subject"
        >Boleto ${object.invoice_date_due.strftime("%d/%m/%Y")} - ${object.invoice_origin}</field>
        <field name="lang">${object.partner_id.lang}</field>
        <field
            name="email_from"
        >${(object.invoice_user_id.email_formatted or user.email_formatted) |safe}</field>
        <field name="partner_to">${object.partner_id.id}</field>
        <field name="model_id" ref="model_account_move" />
        <field name="user_signature" eval="False" />
        <field name="auto_delete" eval="False" />
        <field name="report_template" ref="account.account_invoices" />
        <field
            name="report_name"
        >Fatura_${(object.name or '').replace('/','_')}${object.state == 'draft' and '_draft' or ''}</field>
        <field
            name="body_html"
        ><![CDATA[
          <div style="background:#F0F0F0;color:#515166;padding:10px 0px;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
                          <table style="width:600px;margin:5px auto;">
                              <tbody>
                                  <tr><td>
                                      <a href="/"><img src="/web/binary/company_logo" style="vertical-align: baseline; max-width: 100px; width: auto; height: auto;"></a>
                                  </td><td style="text-align:right;vertical-align:middle;">
                                          Fatura de Locação
                                  </td></tr>
                              </tbody>
                          </table>
                          <table style="width:600px;margin:0px auto;background:white;border:1px solid #e1e1e1;">
                              <tbody>
                                  <tr><td style="padding:15px 20px 10px 20px;">
                                      <p>Caro(a) ${object.partner_id.name}&nbsp;</p>
                                      <p>
                                          <br></p><p style="margin-left:1.5em;">Aqui está a
                                          % if object.name:
                                              fatura <strong>${object.name}</strong>
                                          % else:
                                              fatura
                                          %endif
                                          % if object.invoice_origin:
                                              (${object.invoice_origin})
                                          % endif
                                          &nbsp;no valor de <strong>${format_amount(object.amount_total, object.currency_id)}</strong>.
                                          % if object.invoice_payment_state == 'paid':
                                              Esta fatura já se encontra paga.
                                          % else:
                                              <br><br><strong>Evite multas e juros pagando o seu boleto até o vencimento.</strong>
                                          % endif
                                      </p>
                                      <p style="margin-left:1.5em;"><br></p><p style="margin-left:1.5em;">Se tiver alguma dúvida, não hesite em contactar-me.</p>
                                  </td></tr>
                              </tbody>
                          </table>
                      </div>

        ]]></field>
    </record>

    <record id="email_rent_proposal_template" model="mail.template">
        <field name="name">Aluguel de Frota: Proposta de Locação</field>
        <field name="subject">Proposta / Contrato de Locação - ${object.name or ''} - ${object.vehicle_id.name or ''}</field>
        <field name="lang">${object.tenant_id.lang if object.tenant_id else False}</field>
        <field name="email_from">${(user.email_formatted or user.company_id.email_formatted) |safe}</field>
        <field name="partner_to">${object.tenant_id.id if object.tenant_id else ''}</field>
        <field name="model_id" ref="fleet_rent.model_fleet_rent" />
        <field name="user_signature" eval="False" />
        <field name="auto_delete" eval="False" />
        <field name="report_template" ref="report_fleet_rent_proposal" />
        <field name="report_name">Contrato_${(object.name or '').replace('/','_')}</field>
        <field name="body_html"><![CDATA[
<div style="background:#F0F0F0;color:#515166;padding:10px 0px;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
    <table style="width:600px;margin:5px auto;">
        <tbody>
            <tr>
                <td>
                    <a href="/"><img src="/web/binary/company_logo" style="vertical-align:baseline;max-width: 100px; width: auto; height: auto;"></a>
                </td>
                <td style="text-align:right;vertical-align:middle;">
                    Proposta de locação
                </td>
            </tr>
        </tbody>
    </table>
    <table style="width:600px;margin:0px auto;background:white;border:1px solid #e1e1e1;">
        <tbody>
            <tr>
                <td style="padding:15px 20px 10px 20px;">
                    <p>Olá ${object.tenant_id.name or ''}&nbsp;</p>
                    <p>&nbsp;</p>
                    <p style="margin-left:1.5em;">Segue proposta de locação,&nbsp;<span style="font-weight:bolder;">leia com atenção!</span></p>
                    <p style="margin-left:1.5em;"><br></p>
                    <p style="margin-left:1.5em;">RECOMENDAÇÕES PARA ESTE CONTRATO:</p>
                    <p style="margin-left:1.5em;"><br></p>
                    <p style="margin-left:1.5em;">- Este contrato é formado por:<b><br></b></p>
                    <ol>
                        <li class="o_indent">
                            <ol>
                                <li><p style="margin-left:1.5em;"><b>Proposta/Contrato de Locação com&nbsp;</b><span style="font-weight:bolder;font-style: inherit; font-variant-ligatures: inherit; font-variant-caps: inherit; text-align: inherit;">Termos Gerais de Locação</span><b>; e</b></p></li>
                                <li><p style="margin-left:1.5em;"><b>Laudo de Vistoria</b>.</p></li>
                            </ol>
                        </li>
                    </ol>
                    <p style="margin-left:1.5em;"><b>- Todos os documentos devem ser lidos com atenção.</b></p>
                    <p style="margin-left:1.5em;"><br></p>
                    <p style="margin-left:1.5em;">- Verifique se todos os seus dados estão corretos.</p>
                    <p style="margin-left:1.5em;"><br></p>
                    <p style="margin-left:1.5em;">- Qualquer dúvida ou discordância deve ser comunicada ao nosso time antes da assinatura do contrato. Retorne este e-mail ou entre em contato conosco por telefone ou aplicativos de mensagem.</p>
                    <p style="margin-left:1.5em;"><br></p>
                    <p style="margin-left:1.5em;">- A Proposta/Contrato de Locação deverá ser assinada por todas as partes envolvidas na negociação.</p>
                    <p style="margin-left:1.5em;"><b><br></b></p>
                    <p style="margin-left:1.5em;">- Recomendamos realizar a <b>Assinatura Eletrônica do GOV.BR</b>&nbsp; (<span style="text-align:inherit;"><a href="https://www.gov.br/governodigital/pt-br/assinatura-eletronica">https://www.gov.br/governodigital/pt-br/assinatura-eletronica</a>)</span><span style="font-family:Roboto, &quot;Odoo Unicode Support Noto&quot;, sans-serif;font-style: inherit; font-variant-ligatures: inherit; font-variant-caps: inherit; font-weight: inherit; text-align: inherit;">.</span></p>
                    <p style="margin-left:1.5em;">
                        <span style="font-family:Roboto, &quot;Odoo Unicode Support Noto&quot;, sans-serif;">&nbsp; &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;</span><br style="font-family:Roboto, &quot;Odoo Unicode Support Noto&quot;, sans-serif;">
                        <span style="font-family:Roboto, &quot;Odoo Unicode Support Noto&quot;, sans-serif;">______________________________________________________________</span><br style="font-family:Roboto, &quot;Odoo Unicode Support Noto&quot;, sans-serif;"><br style="font-family:Roboto, &quot;Odoo Unicode Support Noto&quot;, sans-serif;">
                        <span style="font-family:Roboto, &quot;Odoo Unicode Support Noto&quot;, sans-serif;">LAUDO DE VISTORIA</span><br><br style="font-family:Roboto, &quot;Odoo Unicode Support Noto&quot;, sans-serif;">
                        <span style="font-family:Roboto, &quot;Odoo Unicode Support Noto&quot;, sans-serif;">Será anexado ao contrato um laudo de vistoria do veículo. Este documento descreve as condições gerais do veículo. Com este laudo, no final da locação, junto com a&nbsp;entrega da chave, será procedida vistoria de danos aparentes ao veículo.&nbsp;</span><br>
                        <span style="text-align:inherit;"><br>Faça uma leitura prévia do modelo de laudo de vistoria para conhecer os itens que serão vistoriados. <br><br>O preenchimento do laudo de vistória será feito de forma eletrônica:</span>
                    </p>
                    <a href="https://vehicle-inspection-app-1005479144456.us-central1.run.app/" class="btn btn-warning btn-sm" target="_blank">clique aqui para realizar a vistoria!</a><br>
                    <p style="margin-left:1.5em;"><br></p>
                    <p style="margin-left:1.5em;">Se tiver alguma dúvida, não hesite em contactar-nos.</p>
                </td>
            </tr>
            <tr>
                <td style="padding:15px 20px 10px 20px;"><p><br></p></td>
            </tr>
        </tbody>
    </table>
    <img src="${object.get_proposal_tracking_url()}" style="display:none;width:1px;height:1px;border:0;" width="1" height="1" alt="" />
</div>
        ]]></field>
    </record>
</odoo>
