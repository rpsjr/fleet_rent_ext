<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="paperformat_lowmargin" model="report.paperformat">
        <field name="name">A4 low margin</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">4</field>
        <field name="margin_left">4</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <template id="custom_layout_footer">
        <div class="footer">
            <div class="text-center">
                <ul class="list-inline">
                </ul>
            </div>
        </div>
    </template>

    <template id="custom_layout_header">
        <div class="header">
            <div class="header">
            </div>
        </div>
    </template>

    <template id="jt_report_external_layout">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id" />
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company" />
        </t>
        <div class="article">
            <t t-call="fleet_rent_ext.custom_layout_header" />
            <t t-raw="0" />
            <t t-call="fleet_rent_ext.custom_layout_footer" />
        </div>
    </template>

    <template id="rent_proposal_pdf">
      <t t-name="rent_proposal_pdf">
            <t t-call="web.html_container">
                <t t-foreach="docs.exists()" t-as="o">
                  <t
                        t-set="rent"
                        t-value="o if o._name == 'fleet.rent' else (o.rent_id if o.rent_id and o.rent_id.exists() else (o.env['fleet.rent'].search([('agreement_id', '=', o.id)], limit=1) if o._name == 'agreement' and o.exists() else False))"
                    />
                  <t
                        t-set="tenant"
                        t-value="rent.tenant_id if rent and rent.tenant_id else (o.partner_id if o._name == 'agreement' and o.exists() and o.partner_id else False)"
                    />
                  <t t-call="fleet_rent_ext.jt_report_external_layout">
                         <div
                            class="page"
                            style="font-family: Arial, sans-serif; font-size: 11pt; line-height: 14pt;"
                        >
                             <span>
                               <ul
                                    class="list-inline"
                                    style="list-style-type: none; padding: 0;"
                                >

                                 <img
                                        t-if="o.company_id.logo"
                                        t-att-src="image_data_uri(o.company_id.logo)"
                                        class="float-left"
                                        alt="Logo"
                                        height="72"
                                        width="175"
                                        style='margin:0px;padding-top:0px;'
                                    />

                                 <p
                                        class="titulo"
                                        align="right"
                                        style="text-align: right; line-height: 16pt; background: transparent; font-size: 16pt; font-family: Arial, sans-serif; font-weight: bold;"
                                    >Proposta/Contrato de Locação <a
                                            t-if="rent"
                                            t-field="rent.name"
                                        /><a t-if="not rent" t-field="o.name" /></p>

                                 <br />
                                 <br />

                                 <p
                                        class="locador"
                                        style="text-align: justify; text-indent: 0cm; line-height: 12.95pt; background: transparent; font-size: 11pt; font-family: Arial, sans-serif;"
                                    ><b>Locador:</b><sup> </sup><b><a
                                                t-field="o.company_id"
                                            /></b> com sede em <a
                                            t-field="o.company_id.city_id"
                                        />, <a
                                            t-field="o.company_id.state_id"
                                        />, inscrita no CNPJ nº <a
                                            t-field="o.company_id.l10n_br_cnpj_cpf"
                                        />.</p>

                                 <t t-if="tenant">
                                 <p
                                            class="proponente"
                                            style="text-align: justify; text-indent: 0cm; line-height: 12.95pt; background: transparent; font-size: 11pt; font-family: Arial, sans-serif;"
                                        ><b>Proponente/Locatário:</b><sup> </sup><b><a
                                                    t-field="tenant.name"
                                                />, </b><a
                                                t-field="tenant.marital_status"
                                            />, nacionalidade: brasileiro(a), profissão:  <a
                                                t-field="tenant.function"
                                            />, carteira nacional de habilitação (CNH) n.º <a
                                                t-field="tenant.d_id"
                                            />, CPF n.º <a
                                                t-field="tenant.l10n_br_cnpj_cpf"
                                            />, residente em: <a
                                                t-field="tenant.street"
                                            />, <a
                                                t-field="tenant.l10n_br_number"
                                            /> - <a
                                                t-field="tenant.l10n_br_district"
                                            />, <a t-field="tenant.city_id" /> -   <a
                                                t-field="tenant.state_id"
                                            />, CEP   <a
                                                t-field="tenant.zip"
                                            />, endereço de correio eletrônico <b>  <a
                                                    t-field="tenant.email"
                                                /></b>.</p>
                                 </t>

                                 <p
                                        class="par3"
                                        style="text-align: justify; text-indent: 0cm; line-height: 12.95pt; background: transparent; font-size: 11pt; font-family: Arial, sans-serif;"
                                    >O Proponente/Locatário declara-se ciente e de pleno acordo com as disposições contidas nas <b
                                        >Cláusulas Gerais do Contrato de Locação de Veículo</b>, que integram este contrato, cuja cópia recebeu antes do ato da assinatura deste instrumento e também, com as informações do <b
                                        >Laudo de Vistoria</b>, que descreve o veículo e o seu estado de conservação no momento em que o mesmo foi entregue ao Proponente/Locatário, forming todos um documento único e indivisível.</p>

                                 <p
                                        class="par4"
                                        style="text-align: justify; text-indent: 0cm; line-height: 12.95pt; background: transparent; font-size: 11pt; font-family: Arial, sans-serif;"
                                    >O acolhimento desta Proposta/Contrato não implica em aceitação da proposta por parte do Locador estando tal aceitação condicionada à assinatura do Locador e à entrega do veículo locado.</p>

                                 <t t-if="rent">
                                 <p
                                            class="tit_claus"
                                            style="margin-bottom:2pt; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                        >
                                   <b>CLÁUSULA 1ª - DO OBJETO</b>
                                 </p>
                                 <p
                                            class="claus_1"
                                            style="margin : 0; padding-top:0; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                        >Por meio deste contrato, que firmam entre si o LOCADOR e o LOCATÁRIO, regula-se a locação do VEÍCULO: <a
                                                t-field="rent.vehicle_id.model_id"
                                            />, ano modelo <a
                                                t-field="rent.vehicle_id.model_year"
                                            />, cor <a
                                                t-field="rent.vehicle_id.vehical_color_id"
                                            />, com ar condicionado, com placa <a
                                                t-field="rent.vehicle_id.license_plate"
                                            />, e com o valor de mercado aproximado em <a
                                                t-field="rent.vehicle_id.resale_value"
                                                t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: rent.currency_id}"
                                            /> (<a
                                                t-field="rent.resale_value_extenso"
                                            />).</p>
                                 <p
                                            class="tit_claus"
                                            style="margin-bottom:0; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                        >
                                   <b>CLÁUSULA 2ª - DO VALOR DO ALUGUEL</b>
                                 </p>
                                 <p
                                            class="claus_2"
                                            style="margin : 0; padding-top:0; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                        >Pela presente locação, obriga o LOCATÁRIO a pagar o valor semanal de <a
                                                t-field="rent.rent_amt"
                                                t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: rent.currency_id}"
                                            /> (<a
                                                t-field="rent.rent_amt_extenso"
                                            />).</p>
                                 <p
                                            class="tit_claus"
                                            style="margin-bottom:2pt; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                        >
                                   <b>CLÁUSULA 3ª - DA FRANQUIA DE QUILOMETRAGEM</b>
                                 </p>
                                 <t t-if="not rent.rent_product.mileage_control">
                                   <p
                                                class="claus"
                                                style="text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                            >A locação é livre de controle de quilometragem.</p>
                                 </t>
                                 <t t-if="rent.rent_product.mileage_control">
                                   <p
                                                class="claus"
                                                style="text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                            >A quilometragem é controlada e o limite de circulação semanal é de <a
                                                    t-field="rent.rent_product.mileage_allowance.mileage_allowance_km"
                                                /> kms (<a
                                                    t-field="rent.mileage_allowance_extenso"
                                                /> quilômetros).</p>
                                 </t>
                                 <p
                                            class="tit_claus"
                                            style="margin-bottom:2pt; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                        >
                                   <b>CLÁUSULA 4ª - DA GARANTIA E DO PAGAMENTO</b>
                                 </p>
                                 <t t-if="rent.deposit_amt">
                                   <p
                                                class="claus"
                                                style="margin : 0; padding-top:0; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                            >O cumprimento das obrigações previstas neste contrato, inclusive o pagamento pontual do aluguel, estará garantido através de caução dada em dinheiro, perfazendo o montante de <a
                                                    t-field="rent.deposit_amt"
                                                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: rent.currency_id}"
                                                /> (<a
                                                    t-field="rent.deposit_amt_extenso"
                                                />), transferido à conta bancária da LOCADORA.</p>
                                 </t>
                                 <t t-if="not rent.deposit_amt">
                                   <p
                                                class="claus"
                                                style="margin : 0; padding-top:0; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                            >Este contrato é pactuado sem depósito de garantia e portanto os valores de locação são devidos antecipadamente.</p>
                                 </t>
                                 <p
                                            class="tit_claus"
                                            style="margin-bottom:2pt; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                        >
                                   <b>CLÁUSULA 5ª - DO LOCAL DE DEVOLUÇÃO</b>
                                 </p>
                                 <p
                                            class="claus"
                                            style="margin : 0; padding-top:0; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                        >O Veículo será devolvido ao LOCADOR pelo LOCATÁRIO na <a
                                                t-field="o.company_id.street"
                                            />, <a
                                                t-field="o.company_id.l10n_br_number"
                                            /><t t-if="o.company_id.street2"> - <a
                                                t-field="o.company_id.street2"
                                            /></t><t t-if="o.company_id.l10n_br_district"> - <a
                                                t-field="o.company_id.l10n_br_district"
                                            /></t>, <a
                                                t-field="o.company_id.city_id"
                                            /><t t-if="o.company_id.state_id"> - <a
                                                t-field="o.company_id.state_id"
                                            /></t><t t-if="o.company_id.zip">, CEP <a
                                                t-field="o.company_id.zip"
                                            /></t>.</p>
                                 </t>

                                 <hr
                                        style="margin-top: 20px; margin-bottom: 20px; border-top: 1px solid #ccc;"
                                    />

                                  <t t-set="agr" t-value="o if o._name == 'agreement' and o.exists() else (rent.agreement_id if rent and rent.agreement_id and rent.agreement_id.exists() else False)"/>
                                  <t t-set="template_fallback" t-value="o.env['agreement'].search([('is_template', '=', True)], limit=1) if o and o.exists() else False"/>
                                  <t t-set="agr_to_use" t-value="agr if agr and (agr.sections_ids or agr.clauses_ids) else (agr if agr else template_fallback)"/>
                                  <t t-set="sec_list" t-value="agr_to_use.sections_ids if agr_to_use and agr_to_use.sections_ids else False"/>
                                  <t t-set="direct_claus_list" t-value="agr_to_use.clauses_ids if agr_to_use and not sec_list and agr_to_use.clauses_ids else False"/>

                                  <div
                                         class="termos_gerais"
                                         style="text-align: justify; font-size: 10pt; line-height: 13pt;"
                                         t-if="sec_list or direct_claus_list"
                                     >
                                      <h3
                                             style="text-align: center; font-weight: bold;"
                                         >TERMOS GERAIS DE LOCAÇÃO — <t t-esc="o.company_id.name or 'BABUR'"/></h3>
                                      <p
                                             style="text-align: center; font-style: italic;"
                                         >(versão vinculada ao contrato<t t-if="agr_to_use and agr_to_use.name">: <t t-esc="agr_to_use.name"/></t>)</p>

                                      <t t-if="sec_list">
                                          <t t-foreach="sec_list" t-as="sec">
                                              <h4 style="margin-top: 12px; margin-bottom: 4px; font-weight: bold;">
                                                  <t t-esc="sec_index + 1"/>. <t t-esc="sec.title or sec.name"/>
                                              </h4>
                                              <t t-set="claus_list" t-value="sec.clauses_ids if 'clauses_ids' in sec._fields and sec.clauses_ids else False"/>
                                              <t t-if="claus_list">
                                                  <t t-foreach="claus_list" t-as="claus">
                                                      <p style="margin-bottom: 6px; text-align: justify;">
                                                          <t t-if="len(claus_list) &gt; 1">
                                                              <b><t t-esc="sec_index + 1"/>.<t t-esc="claus_index + 1"/>.</b> 
                                                          </t>
                                                          <span t-raw="claus.content"/>
                                                      </p>
                                                  </t>
                                              </t>
                                              <t t-if="not claus_list and 'content' in sec._fields and sec.content">
                                                  <p style="margin-bottom: 6px; text-align: justify;">
                                                      <span t-raw="sec.content"/>
                                                  </p>
                                              </t>
                                          </t>
                                      </t>

                                      <t t-if="not sec_list and direct_claus_list">
                                          <t t-foreach="direct_claus_list" t-as="claus">
                                              <p style="margin-bottom: 6px; text-align: justify;">
                                                  <b>CLÁUSULA <t t-esc="claus_index + 1"/> — <t t-esc="claus.title or claus.name"/>:</b>
                                                  <span t-raw="claus.content"/>
                                              </p>
                                          </t>
                                      </t>
                                  </div>

                                 <p
                                        class="claus"
                                        style="text-align: justify; font-size: 11pt; font-family: Arial, sans-serif; margin-top: 15px;"
                                    >  <b
                                        >Declara, sob as penas da lei, que as informações constantes deste documento são verdadeiras</b>.</p>
                                 <p
                                        class="claus"
                                        style="margin-bottom:2pt; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                    >Local e data</p>
                                 <p
                                        class="claus"
                                        style="margin : 0; padding-top:0; text-align: justify; font-size: 11pt; font-family: Arial, sans-serif;"
                                    ><a
                                            t-if="tenant and tenant.city_id"
                                            t-field="tenant.city_id"
                                        /><a
                                            t-if="not (tenant and tenant.city_id)"
                                        >Salvador</a>, <a
                                            t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"
                                        /></p>
                                 <br />
                                 <br />
                               </ul>
                             </span>
                             <table style="width: 100%; margin-top: 20px;">
                             <tbody>
                               <tr style="height: 24px;">
                                 <td
                                            style="width: 45%; border-top: 2px solid black; height: 24px;"
                                        >Proponente/Locatário:</td>
                                 <td
                                            style="width: 10%; height: 24px;"
                                        ><![CDATA[&nbsp]]>;</td>
                                 <td
                                            style="width: 45%; border-top: 2px solid black; height: 24px;"
                                        >Locadora:</td>
                               </tr>
                               <tr style="height: 19px;">
                                 <td style="width: 45%; height: 19px;"><a
                                                t-if="tenant"
                                                t-field="tenant.name"
                                            /></td>
                                 <td
                                            style="width: 10%; height: 19px;"
                                        ><![CDATA[&nbsp]]>;</td>
                                 <td style="width: 45%; height: 19px;"><a
                                                t-field="o.company_id"
                                            /></td>
                               </tr>
                               <tr style="height: 19px;">
                                 <td style="width: 45%; height: 19px;">CPF:<a
                                                t-if="tenant"
                                                t-field="tenant.l10n_br_cnpj_cpf"
                                            /></td>
                                 <td
                                            style="width: 10%; height: 19px;"
                                        ><![CDATA[&nbsp]]>;</td>
                                 <td
                                            style="width: 45%; height: 19px;"
                                        ><![CDATA[&nbsp]]>;</td>
                               </tr>
                               <tr style="height: 40px;">
                                 <td style="width: 45%;"><![CDATA[&nbsp]]>;</td>
                                 <td style="width: 10%;"><![CDATA[&nbsp]]>;</td>
                                 <td style="width: 45%;"><![CDATA[&nbsp]]>;</td>
                               </tr>
                               <tr style="height: 24px;">
                                 <td
                                            style="width: 45%; border-top: 2px solid black; height: 24px;"
                                        >Testemunha 1:</td>
                                 <td
                                            style="width: 10%; height: 24px;"
                                        ><![CDATA[&nbsp]]>;</td>
                                 <td
                                            style="width: 45%; border-top: 2px solid black; height: 24px;"
                                        >Testemunha 2:</td>
                               </tr>
                               <tr style="height: 23px;">
                                 <td style="width: 45%;">CPF:</td>
                                 <td style="width: 10%;"><![CDATA[&nbsp]]>;</td>
                                 <td style="width: 45%;">CPF:</td>
                               </tr>
                             </tbody>
                             </table>
                         </div>
                    </t>
                 </t>
              </t>
           </t>
    </template>

    <!-- Fleet Rent Reports -->
    <report
        id="report_fleet_rent_proposal"
        model="fleet.rent"
        string="Proposal/Contract"
        report_type="qweb-pdf"
        name="fleet_rent_ext.rent_proposal_pdf"
        file="fleet_rent_ext.rent_proposal_pdf"
        paperformat="fleet_rent_ext.paperformat_lowmargin"
        print_report_name="'Contrato - %s - %s - %s' % (object.name if object and object.exists() else '', (object.vehicle_id.model_id.name if object and object.exists() and object.vehicle_id and object.vehicle_id.model_id else (object.vehicle_id.name if object and object.exists() and object.vehicle_id else '')) or '', (object.tenant_id.name or '').split()[0] if object and object.exists() and object.tenant_id and object.tenant_id.name else '')"
    />

    <!-- Agreement Report integration -->
    <report
        id="report_fleet_rent_agreement"
        model="agreement"
        string="Agreement / Contrato de Locação"
        report_type="qweb-pdf"
        name="fleet_rent_ext.rent_proposal_pdf"
        file="fleet_rent_ext.rent_proposal_pdf"
        paperformat="fleet_rent_ext.paperformat_lowmargin"
        print_report_name="'Contrato - %s - %s - %s' % (((object.rent_id if object.rent_id and object.rent_id.exists() else object.env['fleet.rent'].search([('agreement_id', '=', object.id)], limit=1)).name or object.name or '') if object and object.exists() else '', ((object.rent_id if object.rent_id and object.rent_id.exists() else object.env['fleet.rent'].search([('agreement_id', '=', object.id)], limit=1)).vehicle_id.model_id.name or (object.rent_id if object.rent_id and object.rent_id.exists() else object.env['fleet.rent'].search([('agreement_id', '=', object.id)], limit=1)).vehicle_id.name or '') if object and object.exists() else '', (((object.rent_id if object.rent_id and object.rent_id.exists() else object.env['fleet.rent'].search([('agreement_id', '=', object.id)], limit=1)).tenant_id.name or object.partner_id.name or '').split()[0] if object and object.exists() else ''))"
    />

</odoo>
