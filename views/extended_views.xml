<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <data>

    <!--Contract Form View-->
    <record id="contract_contract_form_view" model="ir.ui.view">
        <field name="name">contract.contract form view (in contract)</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
          <xpath expr="//group[@name='main']" position="inside">
            <field name="origin_doc_fleet" />
          </xpath>
        </field>
    </record>


    <!--Rent Type Form View-->
    <record id="rent_type_form" model="ir.ui.view">
        <field name="name">rent.type.form</field>
        <field name="model">rent.type</field>
        <field name="inherit_id" ref="fleet_rent.rent_type_form" />
        <field name="arch" type="xml">
          <xpath expr="//field[@name='renttype']" position="after">
            <field name="payment_term" required="1" />
          </xpath>
        </field>
    </record>

    <!-- Inherited vehicle registration form view added extra fields on fleet vehicle -->
    <record id='view_fleet_rent_form_ext' model='ir.ui.view'>
        <field name="name">view.fleet.rent.form</field>
        <field name="model">fleet.rent</field>
        <field name="inherit_id" ref="fleet_rent.view_fleet_rent_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
              <button
                        name="action_create_agreement"
                        string="Gerar Agreement"
                        type="object"
                        attrs="{'invisible': [('agreement_id', '!=', False)]}"
                        class="oe_highlight"
                    />
              <button
                        name="action_print_proposal"
                        string="Imprimir Proposta"
                        type="object"
                        class="oe_highlight"
                    />
              <button
                        name="action_send_proposal_email"
                        string="Enviar Proposta por E-mail"
                        type="object"
                        class="oe_highlight"
                    />
              <!-- BPMN Rent Sale Step Buttons com Estados de Espera -->
              <button
                        name="action_share_crlv"
                        string="Compartilhar CRLV-e"
                        type="object"
                        states="draft,proposal_sent"
                        class="oe_highlight"
                    />
              <button
                        name="action_send_for_signature"
                        string="Enviar p/ Assinatura"
                        type="object"
                        states="crlv_shared,proposal_sent"
                        class="oe_highlight"
                    />
              <button
                        name="action_confirm_contract_signed"
                        string="Confirmar Assinatura"
                        type="object"
                        states="waiting_signature"
                        class="oe_highlight"
                    />
              <button
                        name="action_schedule_inspection"
                        string="Agendar Vistoria"
                        type="object"
                        states="contract_signed"
                        class="oe_highlight"
                    />
              <button
                        name="action_confirm_inspected"
                        string="Concluir Vistoria"
                        type="object"
                        states="waiting_inspection"
                        class="oe_highlight"
                    />
              <button
                        name="action_indicate_driver_senatran"
                        string="Indicar Condutor (SENATRAN)"
                        type="object"
                        states="inspected"
                        class="oe_highlight"
                    />
              <button
                        name="action_confirm_driver_registered"
                        string="Confirmar Aceite SENATRAN"
                        type="object"
                        states="waiting_senatran"
                        class="oe_highlight"
                    />
              <button
                        name="action_deposite_receive"
                        string="Cobrar Caução (Fatura)"
                        type="object"
                        states="driver_registered"
                        class="oe_highlight"
                    />
              <button
                        name="action_confirm_deposit_paid"
                        string="Confirmar Depósito"
                        type="object"
                        states="waiting_deposit"
                        class="oe_highlight"
                    />
              <button
                        name="action_rent_confirm"
                        string="Iniciar Locação"
                        type="object"
                        states="deposit_received"
                        class="oe_highlight"
                    />
              <button
                        name="action_set_to_draft"
                        string="Retornar a Rascunho"
                        type="object"
                        states="proposal_sent,crlv_shared,waiting_signature,contract_signed,waiting_inspection,inspected,waiting_senatran,driver_registered,waiting_deposit,deposit_received,cancel"
                    />
              <button
                        name="action_cancel"
                        string="Cancelar"
                        type="object"
                        states="draft,proposal_sent,crlv_shared,waiting_signature,contract_signed,waiting_inspection,inspected,waiting_senatran,driver_registered,waiting_deposit,deposit_received"
                    />
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,proposal_sent,waiting_signature,waiting_inspection,waiting_senatran,waiting_deposit,open,done</attribute>
            </xpath>
            <xpath expr="//field[@name='tenant_id']" position="replace">
              <field
                        name="tenant_id"
                        context=""
                        placeholder="Tenant Name"
                        required="1"
                        options="{'no_create': False, 'no_open': False}"
                    />
            </xpath>
            <!-- domain="[('is_driver','=',True)]" -->
            <xpath expr="//field[@name='rent_amt']" position="before">
              <field name="rent_product" required="1" />
            </xpath>
            <xpath expr="//field[@name='date_start']" position="before">
              <field
                        name="rent_contract"
                        required="0"
                        readonly="1"
                        placeholder="Rental Contract"
                        domain="[('state','!=','write-off'),
                      ('state','!=','in_progress')]"
                    />
              <field
                        name="agreement_id"
                        readonly="1"
                        placeholder="Agreement Document"
                    />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Processo de Locação / BPMN" name="bpmn_process">
                    <group>
                        <group string="Etapas do Processo">
                            <field name="proposal_sent_date" />
                            <field name="crlv_shared_date" />
                            <field name="sent_signature_date" />
                            <field name="contract_signed_date" />
                            <field name="inspection_scheduled_date" />
                            <field name="inspection_date" />
                            <field name="senatran_indicated_date" />
                            <field name="driver_reg_date" />
                            <field name="deposit_sent_date" />
                            <field name="deposit_date" />
                        </group>
                        <group string="Dados Complementares">
                            <field name="driver_reg_protocol" />
                            <field name="inspection_notes" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherited product.product form view -->
    <record id="inherit_product_normal_form_views" model="ir.ui.view">
        <field name="name">inherit.product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <label for="purchase_ok" position="after">
                <br /><field name="is_rental_prod" />
                <label for="is_rental_prod" />
            </label>
            <xpath expr="//notebook" position="inside">
                <page
                        string="Rent Vehicle"
                        name="rental_vehicle"
                        attrs="{'invisible': [('is_rental_prod','=',False)]}"
                    >
                  <group>
                      <group name="group_general">
                          <field name="mileage_control" string="Controle de KMs" />
                          <field name="mileage_allowance" string="Franquia de KMs" />
                      </group>
                      <group name="group_standard_price">
                          <field name="vehicle_type_id" string="Categoria de Veículo" />
                      </group>
                  </group>
               </page>
            </xpath>
        </field>
    </record>

    <!-- Inherited product.product form view -->
    <record id="inherit_product_template_only_form_views" model="ir.ui.view">
        <field name="name">inherit.product.template.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <label for="purchase_ok" position="after">
                <br /><field name="is_rental_prod" />
                <label for="is_rental_prod" />
            </label>
            <xpath expr="//notebook" position="inside">
                <page
                        string="Rent Vehicle"
                        name="rental_vehicle"
                        attrs="{'invisible': [('is_rental_prod','=',False)]}"
                    >
                  <group>
                      <group name="group_general">
                          <field name="mileage_control" string="Controle de KMs" />
                          <field name="mileage_allowance" string="Franquia de KMs" />

                      </group>
                      <group name="group_standard_price">
                          <field name="vehicle_type_id" string="Categoria de Veículo" />
                      </group>
                  </group>
               </page>
            </xpath>
        </field>
    </record>

    <!-- Action view for Vehicles Rent -->
    <record id="action_fleet_rent_product" model="ir.actions.act_window">
        <field name="name">Rent Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Main Menuitem for Vehicles Rent Products -->
      <menuitem
            id="sub_menu_vehicles_rent_products"
            name="Plans"
            parent="fleet_rent.menu_vehicle_rent"
            action="action_fleet_rent_product"
            sequence="4"
        />


    <menuitem
            name="Fleet"
            id="fleet.menu_root"
            sequence="115"
            groups="fleet.fleet_group_user,fleet_rent.group_vehicle_rent_user"
            web_icon="fleet,static/description/icon.png"
        />

  </data>
</odoo>
